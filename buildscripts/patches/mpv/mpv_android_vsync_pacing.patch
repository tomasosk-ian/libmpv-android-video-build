--- a/video/out/opengl/context_android.c
+++ b/video/out/opengl/context_android.c
@@ -18,21 +18,355 @@
 #include <EGL/egl.h>
 #include <EGL/eglext.h>
 
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <sys/resource.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <android/looper.h>
+
+#include "common/msg.h"
